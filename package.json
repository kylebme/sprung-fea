{
  "name": "bettersim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A friendly, open-source mechanical FEA workspace",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:engine": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "package:mac": "npm run build && npm run bundle:engine && electron-builder --mac dir && node scripts/sign-mac.mjs",
    "dist:mac": "npm run package:mac && electron-builder --prepackaged release/mac-arm64/BetterSim.app --mac dmg",
    "bundle:engine": ".venv/bin/python scripts/bundle-runtime.py",
    "test:e2e": "playwright test",
    "test:all": "npm run test:engine && npm test && npm run test:e2e",
    "setup": "node scripts/setup.mjs",
    "dev:desktop": "node scripts/dev.mjs --electron",
    "test:desktop": "node tests/desktop.mjs",
    "format": "prettier --write src server electron scripts/*.mjs tests/*.mjs tests/*.ts *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "org.bettersim.app",
    "productName": "BetterSim",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "engine/**/*",
      "server/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "samples",
        "to": "samples"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "identity": null
    },
    "asarUnpack": [
      "engine/**/*",
      "server/**/*"
    ]
  }
}
