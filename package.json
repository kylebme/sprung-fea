{
  "name": "sprung-fea",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A friendly mechanical FEA workspace",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/fetch-vtk-wasm.mjs && tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "test:engine": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "package:mac": "npm run build && npm run bundle:engine && electron-builder --mac dir --publish never && node scripts/sign-mac.mjs",
    "dist:mac": "npm run package:mac && electron-builder --prepackaged 'release/mac-arm64/Sprung FEA.app' --mac dmg --publish never",
    "package:win": "npm run build && npm run bundle:engine:win && electron-builder --win nsis --publish never",
    "package:linux": "npm run build && npm run bundle:engine && electron-builder --linux AppImage --publish never",
    "package:win:nvidia": "npm run build && npm run bundle:engine:win -- --gpu && electron-builder --win nsis --publish never -c.nsis.artifactName=Sprung-FEA-Setup-${version}-NVIDIA.${ext}",
    "package:linux:nvidia": "npm run build && npm run bundle:engine -- --gpu && electron-builder --linux AppImage --publish never -c.linux.artifactName=Sprung-FEA-\\${version}-\\${arch}-NVIDIA.\\${ext}",
    "build:solver": "python3 scripts/build-solver.py",
    "bundle:engine": ".venv/bin/python scripts/bundle-runtime.py",
    "bundle:engine:win": ".venv\\Scripts\\python.exe scripts/bundle-runtime.py",
    "test:e2e": "playwright test",
    "test:all": "npm run test:engine && npm test && npm run test:e2e",
    "setup": "node scripts/setup.mjs",
    "dev:desktop": "node scripts/dev.mjs --electron",
    "test:desktop": "node tests/desktop.mjs",
    "test:packaged": "node tests/packaged.mjs",
    "format": "prettier --write src server electron scripts/*.mjs tests/*.mjs tests/*.ts *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kitware/vtk-wasm": "3.0.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "org.sprungfea.app",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "productName": "Sprung FEA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "engine/**/*",
      "server/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "samples",
        "to": "samples"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Sprung-FEA-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Science",
      "artifactName": "Sprung-FEA-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "engine/**/*",
      "server/**/*"
    ]
  }
}
